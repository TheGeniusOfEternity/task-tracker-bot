BOT_TOKEN=
DATABASE_URL=
# Vercel Neon integration with prefix DATABASE can provide this instead of DATABASE_URL.
DATABASE_POSTGRES_URL=
# Telegram numeric user IDs allowed to create a group, comma separated.
ADMIN_TELEGRAM_IDS=
# Generate independent random secrets, 32+ characters each.
WEBHOOK_SECRET=
CRON_SECRET=
APP_URL=https://your-project.vercel.app
# Optional multi-bot mode. Secrets stay in their own environment variables.
BOTS_JSON=
WORK_BOT_TOKEN=
WORK_WEBHOOK_SECRET=
# BOTS_JSON='[{"id":"default","name":"Уборка","tokenEnv":"BOT_TOKEN","webhookSecretEnv":"WEBHOOK_SECRET"},{"id":"work","name":"Рабочие задачи","tokenEnv":"WORK_BOT_TOKEN","webhookSecretEnv":"WORK_WEBHOOK_SECRET"}]'
